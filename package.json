{
  "name": "desa-pendil-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-admin.mts",
    "test:smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "next": "15.5.9",
    "postgres": "3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-icons": "5.5.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.19.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.9",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
