{
	"name": "desa-pendil-backend",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4",
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 4000",
		"build": "vite build",
		"preview": "vite preview --port 4000",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"db:push": "node scripts/db-push.mjs",
		"create-admin": "node scripts/create-admin.mjs"
	},
	"dependencies": {
		"@fontsource-variable/mulish": "5.3.0",
		"@fontsource-variable/open-sans": "5.3.0",
		"@neondatabase/serverless": "^1.2.1",
		"aws4fetch": "^1.0.20",
		"sharp": "^0.35.5",
		"zod": "4.6.7"
	},
	"overrides": {
		"zod": "$zod"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.74.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-vercel": "^7.0.4",
		"@sveltejs/kit": "3.2.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn": "4.23.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
