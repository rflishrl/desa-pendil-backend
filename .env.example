# Copy this file to `.env.local`, then fill in the values. Never commit `.env.local`.

# --- Neon PostgreSQL -----------------------------------------------------------
# Neon > Dashboard > Connection string (Pooled, with sslmode=require)
DATABASE_URI="postgresql://neondb_owner:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Random 32+ character hex string for signing session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Photos --------------------------------------------------------------------
# Vercel Blob token for photo uploads (Free Hobby Plan: 1 GB storage, $0 cost).
# Vercel Dashboard > Storage > Blob > (create a store) > .env.local > BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=""

# --- Frontend ------------------------------------------------------------------
# Frontend origins allowed to read the API from the browser (CORS), separated by commas.
ALLOWED_ORIGINS="http://localhost:3000"

# Makes admin changes show up on the frontend right away:
FRONTEND_URL="http://localhost:3000"
REVALIDATE_SECRET=""

# --- Cron ----------------------------------------------------------------------
# Secret for Vercel Cron (daily cleanup of orphaned photos, see vercel.json).
CRON_SECRET=""
