# Copy this file to `.env.local`, then fill in the values. Never commit `.env.local`.

# --- Neon PostgreSQL -----------------------------------------------------------
# Neon database connection string (obtain from neon.tech or Vercel Marketplace).
# Either DATABASE_URI or DATABASE_URL is accepted.
DATABASE_URI="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret string used to sign HMAC-SHA256 session cookies (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Media Storage (Cloudflare R2 + Vercel Blob transition) -----------------
# Active upload provider: "blob" during transition, "r2" after cutover.
STORAGE_PROVIDER="blob"

# Vercel Blob read-write token (kept during dual-run / rollback window).
BLOB_READ_WRITE_TOKEN=""

# Cloudflare R2 S3-compatible credentials (scoped to the `desa-pendil` bucket).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="desa-pendil"
R2_PUBLIC_DOMAIN="https://media-dp.raflisahrul.my.id"

# Per-app R2 quota guard in MB (2560 MB = 2.5 GB) and upload limit in MB (max 4).
R2_APP_QUOTA_MB="2560"
MAX_UPLOAD_MB="4"

# --- Frontend ------------------------------------------------------------------
# Frontend origins allowed to read the API from the browser (CORS), separated by commas.
# Leave empty if the frontend only calls the API from the server (Server Components).
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Instant cache revalidation on the frontend after admin edits:
# FRONTEND_URL: the address of the frontend application.
# REVALIDATE_SECRET: shared secret matching the frontend REVALIDATE_SECRET.
FRONTEND_URL="http://localhost:5173"
REVALIDATE_SECRET=""

# --- Cron ----------------------------------------------------------------------
# Secret for Vercel Cron (daily cleanup of orphaned photos, see vercel.json).
# Vercel sends it automatically in the Authorization header. Empty = cron is off.
CRON_SECRET=""

# --- Cloudflare Turnstile (Bot & Abuse Defense) --------------------------------
# Configure in Vercel Dashboard > Settings > Environment Variables:
#
# Production:
# - TURNSTILE_SECRET_KEY: Secret key from Cloudflare Zero Trust / Turnstile Dashboard (Never prefix with VITE_).
# - VITE_TURNSTILE_SITE_KEY: Public site key for widget.
# - TURNSTILE_ALLOWED_HOSTNAMES: Comma-separated list of domain hostnames (e.g. desapendil.id,admin.desapendil.id).
#
# Preview & Development (Official Cloudflare dummy testing keys):
# Always passes:
# - TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# - VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# - TURNSTILE_ALLOWED_HOSTNAMES="localhost,127.0.0.1,example.com"
#
# Always blocks:
# - TURNSTILE_SECRET_KEY="2x0000000000000000000000000000000AB"
# - VITE_TURNSTILE_SITE_KEY="2x00000000000000000000AB"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_ALLOWED_HOSTNAMES="localhost,127.0.0.1,example.com"
