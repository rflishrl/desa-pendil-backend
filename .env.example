# --- Docker Compose (database container) ---
POSTGRES_USER=desa
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=desa_pendil
DB_PORT=5432

# --- App ---
# Local dev (database from `docker compose up -d db`):
DATABASE_URL=postgres://desa:change-me-to-a-long-random-password@localhost:5432/desa_pendil
# Session signing key, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Comma-separated origins allowed to call the public API from a browser
FRONTEND_ORIGINS=http://localhost:3000
# Public URL of this backend, used to turn /uploads/... into absolute URLs for the frontend
PUBLIC_BASE_URL=http://localhost:4000
# Vercel Blob read/write token. Leave empty in development to store uploads in .uploads/
BLOB_READ_WRITE_TOKEN=
# Where local uploads are stored when no Blob token is set
UPLOAD_DIR=.uploads

# --- First admin (used by `npm run db:seed`) ---
ADMIN_EMAIL=admin@desapendil.local
ADMIN_PASSWORD=
ADMIN_NAME=Admin Desa
